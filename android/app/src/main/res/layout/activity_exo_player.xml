<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/exo_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Visor de Video Nativo ExoPlayer (Media3) con TextureView para evitar pantalla negra -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_timeout="3500"
        app:show_buffering="when_playing"
        app:surface_type="texture_view"
        app:resize_mode="fit"
        app:controller_layout_id="@layout/custom_player_control_view" />

    <!-- Barra de Carga / Buffering central -->
    <ProgressBar
        android:id="@+id/loading_spinner"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="#22D3EE"
        android:visibility="gone" />

    <!-- Diálogo de Error elegante si el servidor IPTV no responde -->
    <LinearLayout
        android:id="@+id/error_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2070A12"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Error de Reproducción"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxWidth="520dp"
            android:text="No se pudo conectar al flujo de video. El servidor IPTV puede estar ocupado."
            android:textColor="#A1A1AA"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#22D3EE"
                android:focusable="true"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Reintentar"
                android:textColor="#000000"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_error_external"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:backgroundTint="#33FFFFFF"
                android:focusable="true"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Abrir con VLC"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_error_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:backgroundTint="#33FFFFFF"
                android:focusable="true"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Volver al Catálogo"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
