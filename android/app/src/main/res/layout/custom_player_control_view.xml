<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@null">

    <!-- ── 1. CABECERA SUPERIOR CINEMÁTICA CON DEGRADADO FUNDIDO ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_player_top_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp"
        android:paddingBottom="48dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_player_control_selector"
            android:contentDescription="Volver"
            android:focusable="true"
            android:nextFocusDown="@id/exo_progress"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="XNova Player"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/badge_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_quality_bg"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="1080p FHD"
            android:textColor="#22D3EE"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── 2. BARRA INFERIOR COMPLETA ESTILO AMAZON PRIME VIDEO ── -->
    <!-- Estructura: Fila 1 Línea de Tiempo -> Fila 2 Botones de Pausa y Siguiente -> Fila 3 Carrusel de Capítulos -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_player_bottom_gradient"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="28dp"
        android:paddingEnd="36dp"
        android:paddingBottom="24dp">

        <!-- ── FILA 1: TIEMPO Y BARRA DE PROGRESO ── -->
        <LinearLayout
            android:id="@+id/timeline_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textColor="#E4E4E7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:focusable="true"
                android:nextFocusUp="@id/btn_back"
                android:nextFocusDown="@id/exo_play"
                app:bar_height="4dp"
                app:buffered_color="#66FFFFFF"
                app:played_color="#22D3EE"
                app:scrubber_color="#22D3EE"
                app:scrubber_dragged_size="16dp"
                app:scrubber_enabled_size="12dp"
                app:unplayed_color="#33FFFFFF" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textColor="#A1A1AA"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ── FILA 2: BOTONES DE ACCIÓN (PLAY / PAUSA / ADELANTAR / SIGUIENTE EPISODIO) ── -->
        <LinearLayout
            android:id="@+id/player_action_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Retroceder 10 segundos -->
            <ImageButton
                android:id="@id/exo_rew"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_player_control_selector"
                android:contentDescription="Retroceder 10s"
                android:focusable="true"
                android:nextFocusUp="@id/exo_progress"
                android:nextFocusRight="@id/exo_play"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_rew"
                app:tint="#FFFFFF" />

            <!-- Botón Principal Play / Pausa -->
            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="14dp">

                <ImageButton
                    android:id="@id/exo_play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/btn_player_center_play_selector"
                    android:contentDescription="Reproducir"
                    android:focusable="true"
                    android:nextFocusUp="@id/exo_progress"
                    android:nextFocusLeft="@id/exo_rew"
                    android:nextFocusRight="@id/exo_ffwd"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="#000000" />

                <ImageButton
                    android:id="@id/exo_pause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/btn_player_center_play_selector"
                    android:contentDescription="Pausar"
                    android:focusable="true"
                    android:nextFocusUp="@id/exo_progress"
                    android:nextFocusLeft="@id/exo_rew"
                    android:nextFocusRight="@id/exo_ffwd"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_media_pause"
                    app:tint="#000000" />
            </FrameLayout>

            <!-- Adelantar 10 segundos -->
            <ImageButton
                android:id="@id/exo_ffwd"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/btn_player_control_selector"
                android:contentDescription="Adelantar 10s"
                android:focusable="true"
                android:nextFocusUp="@id/exo_progress"
                android:nextFocusLeft="@id/exo_play"
                android:nextFocusRight="@id/btn_next_episode"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_ff"
                app:tint="#FFFFFF" />

            <!-- Botón Siguiente Episodio (Estilo Amazon Prime Video) -->
            <LinearLayout
                android:id="@+id/btn_next_episode"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/btn_next_pill_selector"
                android:contentDescription="Siguiente Episodio"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@id/exo_progress"
                android:nextFocusLeft="@id/exo_ffwd"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:id="@+id/iv_btn_next_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_media_next"
                    app:tint="@color/btn_next_icon_selector" />

                <TextView
                    android:id="@+id/tv_btn_next_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Siguiente Episodio"
                    android:textColor="@color/btn_dialog_action_text_selector"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_player_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↓ Pulsa Flecha Abajo para ver capítulos"
                android:textColor="#71717A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ── FILA 3: CARRUSEL DESPLEGABLE DE CAPÍTULOS DE SERIES / CANALES DE TV (DEBAJO DE LOS BOTONES) ── -->
        <LinearLayout
            android:id="@+id/episodes_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_episodes_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAPÍTULOS DISPONIBLES"
                    android:textColor="#22D3EE"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="• Presiona OK para reproducir"
                    android:textColor="#A1A1AA"
                    android:textSize="10sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/hsv_episodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_episodes_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </HorizontalScrollView>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
